# ============================================================
# Pick AI Agent Service — Environment Variables
# ============================================================
# 复制此文件为 .env，填入实际值后启动服务。
# MVP 最小配置只需填前 4 项（LLM + Embedding），其余有默认值。
# ============================================================

# ── LLM 对话模型（必填）──────────────────────────────────
# 使用 DashScope 兼容端点（OpenAI 兼容协议）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-dashscope-api-key
LLM_MODEL=qwen-plus

# ── Embedding 模型（必填）─────────────────────────────────
# 文本 embedding（DashScope 原生 TextEmbedding API），用于记忆/用户笔记/语义搜索
EMBEDDING_API_KEY=sk-your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1152

# 多模态 embedding（DashScope 原生 MultiModalEmbedding API），用于店铺 RAG 检索（文本 + 图片）
MULTIMODAL_EMBEDDING_MODEL=tongyi-embedding-vision-plus

# ── 记忆提取模型（可选，默认复用 LLM_MODEL）──────────────
# EXTRACTOR_MODEL=qwen-turbo
# EXTRACTOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EXTRACTOR_API_KEY=sk-your-dashscope-api-key

# ── Java 后端（必填）─────────────────────────────────────
JAVA_BASE_URL=http://localhost:8085
SYNC_INTERNAL_TOKEN=internal-dev-token

# ── Milvus 向量数据库（必填，Docker 启动）─────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── Neo4j 图数据库（可选，记忆系统用）─────────────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4j123

# ── Postgres（可选，LangGraph checkpoint 用）─────────────
# PG_CHECKPOINT_URI=postgresql://postgres:postgres@localhost:5432/pick_agent

# ── Kafka（可选，用户反馈消费用）──────────────────────────
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# FEEDBACK_TOPIC=user.behavior.feedback

# ── 店铺图片本地路径（可选，多模态 embedding 用）──────────
# IMAGE_BASE_PATH=D:/Pick/vue3/src/assets/imgs
